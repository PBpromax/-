# CampusHub example environment file.
# Copy to .env for local Docker Compose production demo.
# Do not commit real .env files.

DB_USERNAME=ch_dev
DB_PASSWORD=replace-with-a-strong-database-password
DB_ROOT_PASSWORD=replace-with-a-strong-root-password
CAMPUSHUB_JWT_SECRET=replace-with-a-long-random-base64-secret

# Redis currently has no password in this course demo. It is only exposed inside
# the production Docker network in docker-compose-prod.yml.
